Bootstrap: docker
From: ubuntu:20.04

%setup
    mkdir -p ${SINGULARITY_ROOTFS}/software
    mkdir -p ${SINGULARITY_ROOTFS}/src

%files
    environment.yaml /software/environment.yaml
    . /src

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive

    # System deps
    apt-get update
    apt-get install -y --no-install-recommends software-properties-common
    add-apt-repository universe
    apt-get update

    apt-get install -y --no-install-recommends \
        make \
        gcc-10 \
        g++-10 \
        git \
        libclang-dev \
        libbz2-dev \
        liblzma-dev \
        wget \
        libz-dev \
        libcurl4-openssl-dev \
        libncurses5-dev \
        bzip2 \
        ca-certificates \
        cmake \
        jellyfish

    rm -rf /var/lib/apt/lists/*

    # Prefer gcc-10 / g++-10
    update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-10 100 \
      --slave /usr/bin/g++ g++ /usr/bin/g++-10 \
      --slave /usr/bin/gcov gcov /usr/bin/gcov-10

    cd /software

    # Install Miniconda
    wget -q https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O install_conda.sh
    bash install_conda.sh -b -p /opt/conda
    rm install_conda.sh
    # accept tos
    /opt/conda/bin/conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main
    /opt/conda/bin/conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/r
    # Create env
    /opt/conda/bin/conda env create -f /software/environment.yaml
    /opt/conda/bin/conda clean -a -y

    # Install this repo into the env (exact source copied via %files)
    . /opt/conda/etc/profile.d/conda.sh
    conda activate amira_env
    python -m pip install --no-cache-dir -U pip
    python -m pip install --no-cache-dir /src

    # Install Pandora
    cd /software
    wget -q https://github.com/iqbal-lab-org/pandora/releases/download/0.12.0-alpha.0/pandora-linux-precompiled-v0.12.0-alpha.0 -O pandora
    chmod +x pandora

%environment
    # Conda
    export PATH="/opt/conda/bin:$PATH"
    export PATH="/opt/conda/envs/amira_env/bin:$PATH"
    # Tools
    export PATH="/software:$PATH"

%runscript
    exec "$@"